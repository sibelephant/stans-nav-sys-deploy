# Required by docker compose. Use a long random password in production.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://stans:replace-with-a-long-random-password@postgres:5432/stans

# Set true only when intentionally loading the demo dataset.
SEED_DATABASE=false

# Enable these for a managed PostgreSQL provider using TLS.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true